@using RestaurantWebApp22092026.ViewModels
@{
   
}
@model HomeViewModel
<!doctype html>
<html class="no-js" lang="zxx">
    
<!-- Mirrored from htmldemo.hasthemes.com/basmoti/basmoti/index.html by HTTrack Website Copier/3.x [XR&CO'2014], Wed, 21 Jul 2021 11:15:26 GMT -->
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=UTF-8" /><!-- /Added by HTTrack -->
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>Basmoti - Restaurant Bootstrap 5 Template</title>
    <meta name="description" content="">
    <meta name="robots" content="noindex, follow" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="~/ClientTemplate/img/favicon.png">
		
    <!-- all css here -->
    <link rel="stylesheet" href="~/ClientTemplate/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/ClientTemplate/css/icons.css">
    <link rel="stylesheet" href="~/ClientTemplate/css/plugins.css">
    <link rel="stylesheet" href="~/ClientTemplate/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/ClientTemplate/css/responsive.css">
    <script src="~/ClientTemplate/js/vendor/modernizr-3.11.7.min.js"></script>
</head>
<body>

    @if (ViewData["HideSecondHeader"] as bool? != true)
        {
            <header class="header-area transparent-bar header-black">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-4 col-5 col-sm-4">
                        <div class="logo">
                            <a asp-controller="Home" asp-action="Index">
                                <img class="logo-normal" alt="" style="max-height: 50px; max-width: 130px" src="~/SystemSettingsImages/@Model.SystemSettings.LogoDarkURL">
                                <img class="logo-sticky" alt="" style="max-height: 50px; max-width: 130px" src="~/SystemSettingsImages/@Model.SystemSettings.LogoDarkURL">
                            </a>
                        </div>
                    </div>
                    <div class="col-lg-9 col-md-8 col-7 col-sm-8 relative">
                        <div class="menu-search-bundle">
                            <div class="main-menu">
                                <nav>
                                    <ul>
                                        <li class="top-hover">
                                            <a asp-controller="Home" asp-action="Index">home </a>
                                             
                                        </li>
                                        <li><a asp-controller="Home" asp-action="AboutUs">about</a></li>
                                        <li class="mega-menu-position top-hover">
                                            <a asp-controller="Home" asp-action="Menu">menu </a>
                                             
                                        </li>

                                       
                                        <li><a asp-controller="Home" asp-action="ContactUs">contact us</a></li>
                                    </ul>
                                </nav>
                            </div>
                            <div class="search-wrap">
                                <button class="search-toggle">
                                    <i class="fa fa-search"></i>
                                </button>
                                <div class="search">
                                    <form action="#">
                                        <input type="search" placeholder="Search here">
                                        <button type="submit">
                                            Search
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mobile-menu-area d-md-block d-block col-md-12 col-lg-12 col-12 d-lg-none d-xl-none">
                        <div class="mobile-menu">
                            <nav id="mobile-menu-active">
                                <ul class="menu-overflow">
                                    <li>
                                        <a href="#">HOME</a>
                                        <ul>
                                            <li><a asp-controller="Home" asp-action="Index">home</a></li>
                                        </ul>
                                    </li>
                                    <li>
                                        <a href="#">pages</a>
                                        <ul>
                                            <li><a asp-controller="Home" asp-action="AboutUs">about us </a></li>
                                            <li><a asp-controller="Home" asp-action="Menu">menu </a></li>
                                            <li><a asp-controller="Home" asp-action="ContactUs">contact us</a></li>
                                        </ul>
                                    </li>
                                    <li>
                                        <a href="#">menu</a>
                                        <ul>
                                            <li>
                                                <a href="#">menu list</a>
                                                <ul>
                                                    @foreach (var item in Model.MenuItems)
                                                    {
                                                        <li><a asp-controller="Home" asp-action="Menu">@item.MenuItemsTitle</a></li>
                                                    }
                                                </ul>
                                            </li>
                                        </ul>
                                    </li>
                                    <li>
                                        <a href="#">blog</a>
                                        <ul>
                                            <li><a asp-controller="Home" asp-action="ProductDetails">Blog</a></li>
                                        </ul>
                                    </li>
                                    <li><a asp-controller="Home" asp-action="ContactUs"> Contact us </a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            </header>
        }

    @RenderBody()



    @if (ViewData["HidePartners"] as bool? != true)
    {
        <div class="partner-area">
            <div class="container">
                <div class="brand-logo-area ptb-100">
                    <div class="container">
                        <div class="brand-logo-active owl-carousel">
                                @foreach(var item in Model.Partners)
                                {
                                <div class="single-brand-logo">
                                    <img style="max-width: 194px; max-height: 120px;" alt="~/PartnersImages/@item.PartnersAltImageURL" src="~/PartnersImages/@item.PartnersImageURL">
                                </div>
                                }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }


    <footer class="footer-area">
        <div class="footer-area-top black-bg pt-95 pb-60">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                <h4>@Model.Titles.FirstOrDefault(x => x.TitleKeyword == "AboutUs")?.Title</h4>
                            </div>
                            <div class="footer-about">
                                <p>@Model.About.FirstOrDefault()?.AboutFooterDesc</p>
                                <div class="footer-map">
                                    <a asp-controller="Home" asp-action="ContactUs"><i class="ri-map-pin-line"></i>View on map</a>
                                </div>
                            </div>
                            <div class="social-icon">
                                <ul>
                                        @foreach(var item in Model.SocialMedia)
                                        {
                                        <li><a href="@item.SocialMediaLink"><i class="@item.SocialMediaIcon"></i></a></li>
                                        }

                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                <h4>@Model.Titles.FirstOrDefault(x => x.TitleKeyword == "Contact Us")?.Title</h4>
                            </div>
                            <div class="footer-cont-info">
                                    @foreach(var item in Model.MasterContactUs)
                                    {
                                    <div class="single-footer-cont-info">
                                        <div class="cont-info-icon">
                                            <i class="@item.MasterContactUsIcon"></i>
                                        </div>
                                        <div class="cont-info-content">
                                            <a href="@item.MasterContactUsLink">@item.MasterContactUsText</a>
                                        </div>
                                    </div>
                                    }
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                <h4>@Model.Titles.FirstOrDefault(x => x.TitleKeyword == "OpeningTime")?.Title</h4>
                            </div>
                            <div class="open-time pr-30">
                                <ul>
                                        @foreach(var item in Model.OpeningTime)
                                        {
                                            if(item.IsOpen == true)
                                            {
                                            <li>
                                                @item.OpeningTimeDay
                                                <span>@item.FormattedOpeningTimeStartTime - @item.FormattedOpeningTimeEndTime</span>
                                            </li>
                                            }
                                            else
                                            {
                                            <li>
                                            @item.OpeningTimeDay
                                                <span>Closed</span>
                                            </li>
                                            }
                                        }
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-6 col-12">
                        <div class="footer-widget mb-40">
                            <div class="footer-title mb-30">
                                <h4>@Model.Titles.FirstOrDefault(x => x.TitleKeyword == "Newsletter")?.Title</h4>
                            </div>
                            <div class="newsletter-style">
                                <p>@Model.Titles.FirstOrDefault(x => x.TitleKeyword == "Newsletter")?.TitleDesc</p>
                                <div id="mc_embed_signup" class="subscribe-form ">
                                    <form id="mc-embedded-subscribe-form" asp class="validate" novalidate="" target="_blank" name="mc-embedded-subscribe-form" asp-controller="Home" asp-action="SubscribeNewsletter" method="post">
                                        <div id="mc_embed_signup_scroll" class="mc-form">
                                            <input class="email" type="email" required="" placeholder="Enter your email" name="Email" value="">
                                            <div class="mc-news" aria-hidden="true">
                                                <input type="hidden" value="" tabindex="-1" name="b_6bbb9b6f5827bd842d9640c82_05d85f18ef">
                                            </div>
                                            <div class="clear">
                                                <input id="mc-embedded-subscribe" class="button" type="submit" name="subscribe" value="Subscribe">
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom black-bg-2 pb-25 pt-25">
            <div class="container">
                <div class="copyright text-center">
                    <p>@Model.SystemSettings.FooterText</p>
                </div>
            </div>
        </div>
    </footer>
    <!-- all js here -->
    <script src="~/ClientTemplate/js/vendor/jquery-v1.12.4.min.js"></script>
    <script src="~/ClientTemplate/js/popper.js"></script>
    <script src="~/ClientTemplate/js/bootstrap.min.js"></script>
    <script src="~/ClientTemplate/js/ajax-mail.js"></script>
    <script src="~/ClientTemplate/js/plugins.js"></script>
    <script src="~/ClientTemplate/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>