@using WebAppTemplate.ViewModels
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_LayoutLogin";
}
@model RegisterViewModel
<!doctype html>
<html lang="en">

<head>     
    <meta charset="utf-8" />
    <title>Login | Upcube - Admin & Dashboard Template</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="Themesdesign" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/Admin Template/assets/images/favicon.ico">

    <!-- Bootstrap Css -->
    <link href="~/Admin Template/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/Admin Template/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/Admin Template/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />
</head>

<body>
    <div class="card">
        <div class="card-body">
    
            <div class="text-center mt-4">
                <div class="mb-3">
                    <a href="index.html" class="auth-logo">
                        <img src="~/Admin Template/assets/images/logo-dark.png" height="30" class="logo-dark mx-auto" alt="">
                        <img src="~/Admin Template/assets/images/logo-light.png" height="30" class="logo-light mx-auto" alt="">
                    </a>
                </div>
            </div>
    
            <h4 class="text-muted text-center font-size-18"><b>Register</b></h4>
    
            <div class="p-3">
                <form class="form-horizontal mt-3" asp-action="Register">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3 row">
                        <div class="col-12">
                            <input class="form-control" asp-for="Email" placeholder="Email Address">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

    
                    <div class="form-group mb-3 row">
                        <div class="col-12">
                            <input class="form-control" asp-for="Username" placeholder="Username">
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                    </div>
    
                    <div class="form-group mb-3 row">
                        <div class="col-12">
                            <input class="form-control" asp-for="Password" placeholder="Password">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
    
                    <div class="form-group mb-3 row">
                        <div class="col-12">
                            <input class="form-control" asp-for="ConfirmPassword" placeholder="Rewrite Password">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

    
                    <div class="form-group text-center row mt-3 pt-1">
                        <div class="col-12">
                            <button class="btn btn-info w-100 waves-effect waves-light" type="submit">Register</button>
                        </div>
                    </div>
    
                </form>
                <!-- end form -->
            </div>
        </div>
        <!-- end cardbody -->
    </div>

    <!-- JAVASCRIPT -->
    <script src="~/Admin Template/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/Admin Template/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/Admin Template/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/Admin Template/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/Admin Template/assets/libs/node-waves/waves.min.js"></script>

    <script src="~/Admin Template/assets/js/app.js"></script>
</body>
</html>

