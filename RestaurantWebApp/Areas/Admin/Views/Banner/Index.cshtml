@model RestaurantWebApp22092026.ViewModels.BannerFullViewModel
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-sm-6 col-md-4 col-xl-3">
        <div class="col-lg-12 ">
            <div class="card card-body text-center">
                <h4 class="card-title">Record Configuration</h4>
                <p class="card-text">
                    Press the button below to add a record
                </p>
                <button type="button" class="btn btn-primary btn-rounded waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl">Add a Record</button>
            </div>
        </div>
    </div>
    <!--  Modal content for the above example -->
    <form asp-action="CreateOrUpdate" method="post" asp-controller="Banner" enctype="multipart/form-data" id="terminalForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="BannerImageURL" id="BannerImageURL" />
        <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="myExtraLargeModalLabel">Settings</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="BannerTitle" class="control-label"></label>
                                                        <input asp-for="BannerTitle" class="form-control" />
                                                        <span asp-validation-for="BannerTitle" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="BannerBrief" class="control-label"></label>
                                                        <input asp-for="BannerBrief" class="form-control" />
                                                        <span asp-validation-for="BannerBrief" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="BannerDesc" class="control-label"></label>
                                                        <input asp-for="BannerDesc" class="form-control" />
                                                        <span asp-validation-for="BannerDesc" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="BannerImageURL" class="control-label"></label>
                                                        <input asp-for="BannerImageFile" id="BannerImageFile" type="file" class="form-control" />
                                                        <span asp-validation-for="BannerImageURL" class="text-danger"></span>
                                                        <div id="BannerImagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-check">
                                                        <input asp-for="BannerIsPrimary" class="form-check-input" type="checkbox" id="IsActive" />
                                                        <label asp-for="BannerIsPrimary" class="form-check-label"></label>
                                                    </div>
                                                    <div class="mb-4 form-check">
                                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                                                        <label asp-for="IsActive" class="form-check-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input type="submit" value="Save" class="btn btn-success btn-rounded waves-effect waves-light" />
                        <input type="reset" value="Clear" class="btn btn-warning btn-rounded waves-effect waves-light" />
                        <button type="button" class="btn btnClose btn-light btn-rounded waves-effect waves-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </form>
</div>

<div class="table-responsive">
    <table class="table mb-0">
        
        <thead class="table-light">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.BannerImageURL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BannerTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BannerBrief)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BannerDesc)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.BannerIsPrimary)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.List != null)
            {
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.BannerImageURL) && item.BannerImageURL != "Error")
                            {
                                <img src="~/BannerImages/@item.BannerImageURL" style="max-height: 70px;" class="rounded border mt-1" />
                            }
                            else
                            {
                               <div><h2>None</h2></div>
                            }
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BannerTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BannerBrief)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BannerDesc)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.BannerIsPrimary)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            <a class="btn btn-light btn-rounded waves-effect btnEdit"
                               data-id="@item.Id"
                               data-bannertitle="@item.BannerTitle"
                               data-bannerbrief="@item.BannerBrief"
                               data-bannerdesc="@item.BannerDesc"
                               data-bannerimageurl="@item.BannerImageURL"
                               data-bannerisprimary="@item.BannerIsPrimary"
                               data-isactive="@item.IsActive"
                               data-bs-toggle="modal"
                               data-bs-target=".bs-example-modal-xl">Edit</a>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="DeleteId" value="@item.Id" />
                                <a class="btn btn-danger btn-rounded waves-effect waves-light btnDelete ">Delete</a>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function(){
        $('.btnEdit').click(function(){

        var Id = $(this).data('id');
        var BannerImageURL = $(this).data('bannerimageurl');
        var BannerTitle = $(this).data('bannertitle');
        var BannerBrief = $(this).data('bannerbrief');
        var BannerDesc = $(this).data('bannerdesc');
        var IsActive = $(this).data('isactive');
        var BannerIsPrimary = $(this).data('bannerisprimary');

        $("#Id").val(Id);
        $("#BannerTitle").val(BannerTitle);
        $("#BannerBrief").val(BannerBrief);
        $("#BannerDesc").val(BannerDesc);
        $("#IsActive").prop('checked', IsActive === true || IsActive === 'True' || IsActive === 'true');
        $("#BannerIsPrimary").prop('checked', BannerIsPrimary === true || BannerIsPrimary === 'True' || BannerIsPrimary === 'true');

        $("#BannerImageURL").val(BannerImageURL);

        $("#BannerImageFile").val('');

        if (BannerImageURL) {
        $("#BannerImagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="/BannerImages/${BannerImageURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#BannerImagePreview").empty();
        }
        });

        $('#btnClear').click(function() {
        $("#BannerImagePreview").empty();
        $("#BannerImageURL").val('');
        });

        $('.bs-example-modal-xl').on('hidden.bs.modal', function() {
        $('#terminalForm')[0].reset();
        $('#Id').val('');
        $("#BannerImagePreview").empty();
        $("#BannerImageURL").val('');
        });

        $('.btnDelete').click(function(){
        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {
        if (result.isConfirmed) Swal.fire({
        title: "Deleted!",
        text: "Your file has been deleted.",
        icon: "success"
        });
        $(this).parent().submit();



        });
        })
        })
    </script>
}

