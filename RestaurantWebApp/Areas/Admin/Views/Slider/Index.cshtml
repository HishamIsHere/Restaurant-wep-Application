@model RestaurantWebApp22092026.ViewModels.SliderFullViewModel
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="row justify-content-center">
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="col-lg-12 ">
                <div class="card card-body text-center">
                    <h4 class="card-title">Record Configuration</h4>
                    <p class="card-text">
                        Press the button below to add a record
                    </p>
                    <button type="button" class="btn btn-primary btn-rounded waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl">Add a Record</button>
                </div>
            </div>
        </div>
    <!--  Modal content for the above example -->
    <form asp-action="CreateOrUpdate" method="post" asp-controller="Slider" enctype="multipart/form-data" id="terminalForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="SliderImageURL" id="SliderImageURL" />
        <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="myExtraLargeModalLabel">Settings</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="SliderTitle" class="control-label"></label>
                                                        <input asp-for="SliderTitle" class="form-control" />
                                                        <span asp-validation-for="SliderTitle" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="SliderBrief" class="control-label"></label>
                                                        <input asp-for="SliderBrief" class="form-control" />
                                                        <span asp-validation-for="SliderBrief" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="SliderDesc" class="control-label"></label>
                                                        <input asp-for="SliderDesc" class="form-control" />
                                                        <span asp-validation-for="SliderDesc" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="SliderImageURL" class="control-label"></label>
                                                        <input asp-for="SliderImageFile" id="LogoDarkFile" type="file" class="form-control" />
                                                        <span asp-validation-for="SliderImageURL" class="text-danger"></span>
                                                        <div id="SliderImagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-check">
                                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                                                        <label asp-for="IsActive" class="form-check-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input type="submit" value="Save" class="btn btn-success btn-rounded waves-effect waves-light" />
                        <input type="reset" value="Clear" class="btn btn-warning btn-rounded waves-effect waves-light" />
                        <button type="button" class="btn btnClose btn-light btn-rounded waves-effect waves-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </form>
</div>

<div class="table-responsive">
    <table class="table mb-0">
        
        <thead class="table-light">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.SliderTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SliderBrief)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SliderDesc)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SliderImageURL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.List != null)
            {
                @foreach (var item in Model.List)
                {
                    <tr>
                        <td>
                            <img src="~/SliderImages/@item.SliderImageURL" style="max-height: 70px;" class="rounded border mt-1" />
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SliderTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SliderBrief)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SliderDesc)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IsActive)
                        </td>
                        <td>
                            <a class="btn btn-light btn-rounded waves-effect btnEdit"
                               data-id="@item.Id"
                               data-slidertitle="@item.SliderTitle"
                               data-sliderbrief="@item.SliderBrief"
                               data-sliderdesc="@item.SliderDesc"
                               data-sliderimageurl="@item.SliderImageURL"
                               data-isactive="@item.IsActive"
                               data-bs-toggle="modal"
                               data-bs-target=".bs-example-modal-xl">Edit</a>
                            <form asp-action="Delete" method="post">
                                <input type="hidden" asp-for="DeleteId" value="@item.Id" />
                                <a class="btn btn-danger btn-rounded waves-effect waves-light btnDelete ">Delete</a>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function(){
        $('.btnEdit').click(function(){

        var Id = $(this).data('id');
        var SliderImageURL = $(this).data('sliderimageurl');
        var SliderTitle = $(this).data('slidertitle');
        var SliderBrief = $(this).data('sliderbrief');
        var SliderDesc = $(this).data('sliderdesc');
        var IsActive = $(this).data('isactive');

        $("#Id").val(Id);
        $("#SliderTitle").val(SliderTitle);
        $("#SliderBrief").val(SliderBrief);
        $("#SliderDesc").val(SliderDesc);
        $("#IsActive").prop('checked', IsActive === true || IsActive === 'True' || IsActive === 'true');

        $("#SliderImageURL").val(SliderImageURL);

        $("#SliderImageFile").val('');

        if (SliderImageURL) {
        $("#SliderImagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="/SliderImages/${SliderImageURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#SliderImagePreview").empty();
        }
        });

        $('#btnClear').click(function() {
        $("#SliderImagePreview").empty();
        $("#SliderImageURL").val('');
        });

        $('.bs-example-modal-xl').on('hidden.bs.modal', function() {
        $('#terminalForm')[0].reset();
        $('#Id').val('');
        $("#SliderImagePreview").empty();
        $("#SliderImageURL").val('');
        });

        $('.btnDelete').click(function(){
        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {
        if (result.isConfirmed) Swal.fire({
        title: "Deleted!",
        text: "Your file has been deleted.",
        icon: "success"
        });
        $(this).parent().submit();



        });
        })
        })
    </script>
}
