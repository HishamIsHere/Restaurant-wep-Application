
@model RestaurantWebApp22092026.ViewModels.SystemSettingsFullViewModel
@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div class="row justify-content-center">
    @if (Model == null)
    {
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="col-lg-12 ">
                <div class="card card-body text-center">
                    <h4 class="card-title">Record Configuration</h4>
                    <p class="card-text">
                        Press the button below to add a record
                    </p>
                    <button type="button" class="btn btn-primary btn-rounded waves-effect waves-light" data-bs-toggle="modal" data-bs-target=".bs-example-modal-xl">Add a Record</button>
                </div>
            </div>
        </div>
    }
    
    <!--  Modal content for the above example -->
    <form asp-action="CreateOrUpdate" method="post" asp-controller="SystemSettings" enctype="multipart/form-data" id="terminalForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="LogoDarkURL" id="LogoDarkURL" />
        <input type="hidden" asp-for="LogoLightURL" id="LogoLightURL" />
        <input type="hidden" asp-for="SliderBackgroundURL" id="SliderBackgroundURL" />
        <input type="hidden" asp-for="PopularBackgroundURL" id="PopularBackgroundURL" />
        <input type="hidden" asp-for="ReservationImageURL" id="ReservationImageURL" />
        <div class="modal fade bs-example-modal-xl" tabindex="-1" role="dialog" aria-labelledby="myExtraLargeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="myExtraLargeModalLabel">Settings</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="FooterText" class="control-label"></label>
                                                        <input asp-for="FooterText" class="form-control" />
                                                        <span asp-validation-for="FooterText" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="Location" class="control-label"></label>
                                                        <input asp-for="Location" class="form-control" />
                                                        <span asp-validation-for="Location" class="text-danger"></span>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="LogoDarkURL" class="control-label"></label>
                                                        <input asp-for="LogoDarkFile" id="LogoDarkFile" type="file" class="form-control" />
                                                        <span asp-validation-for="LogoDarkURL" class="text-danger"></span>
                                                        <div id="DarkLogoImagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="LogoLightURL" class="control-label"></label>
                                                        <input asp-for="LogoLightFile" id="LogoLightFile" type="file" class="form-control" />
                                                        <span asp-validation-for="LogoLightURL" class="text-danger"></span>
                                                        <div id="LogoLightImagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="SliderBackgroundURL" class="control-label"></label>
                                                        <input asp-for="SliderBackgroundFile" id="SliderBackgroundFile" type="file" class="form-control" />
                                                        <span asp-validation-for="SliderBackgroundURL" class="text-danger"></span>
                                                        <div id="SliderBackgroundImagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="PopularBackgroundURL" class="control-label"></label>
                                                        <input asp-for="PopularBackgroundFile" id="PopularBackgroundFile" type="file" class="form-control" />
                                                        <span asp-validation-for="PopularBackgroundURL" class="text-danger"></span>
                                                        <div id="PopularBackgroundImagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-group form-control-lg">
                                                        <label asp-for="ReservationImageURL" class="control-label"></label>
                                                        <input asp-for="ReservationImageFile" id="ReservationImageFile" type="file" class="form-control" />
                                                        <span asp-validation-for="ReservationImageURL" class="text-danger"></span>
                                                        <div id="ReservationImagePreview" class="mt-2"></div>
                                                    </div>
                                                    <div class="mb-4 form-check">
                                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="IsActive" />
                                                        <label asp-for="IsActive" class="form-check-label"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <input type="submit" value="Save" class="btn btn-success btn-rounded waves-effect waves-light" />
                        <input type="reset" value="Clear" class="btn btn-warning btn-rounded waves-effect waves-light" />
                        <button type="button" class="btn btnClose btn-light btn-rounded waves-effect waves-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </form>
</div>

<div class="table-responsive">
    <table class="table mb-0">
        
        <thead class="table-light">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LogoDarkURL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LogoLightURL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SliderBackgroundURL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PopularBackgroundURL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReservationImageURL)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Location)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FooterText)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.IsActive)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if(Model?.List != null)
            {
            @foreach (var item in Model.List)
            {
                <tr>
                    <td>
                                <img src="~/SystemSettingsImages/@item.LogoDarkURL" style="max-height: 70px;" class="rounded border mt-1" />
                    </td>
                    <td>
                            <img src="~/SystemSettingsImages/@item.LogoLightURL" style="max-height: 70px;" class="rounded border mt-1" />
                    </td>
                    <td>
                            <img src="~/SystemSettingsImages/@item.SliderBackgroundURL" style="max-height: 70px;" class="rounded border mt-1" />
                    </td>
                    <td>
                            <img src="~/SystemSettingsImages/@item.PopularBackgroundURL" style="max-height: 70px;" class="rounded border mt-1" />
                    </td>
                    <td>
                            <img src="~/SystemSettingsImages/@item.ReservationImageURL" style="max-height: 70px;" class="rounded border mt-1" />
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Location)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FooterText)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.IsActive)
                    </td>
                    <td>
                        <a class="btn btn-light btn-rounded waves-effect btnEdit"
                        data-id="@item.Id"
                        data-footertext="@item.FooterText"
                        data-location="@item.Location"
                        data-logodarkurl="@item.LogoDarkURL"
                        data-logolighturl="@item.LogoLightURL"
                        data-sliderbackgroundurl="@item.SliderBackgroundURL"
                        data-popularbackgroundurl="@item.PopularBackgroundURL"
                        data-reservationimageurl="@item.ReservationImageURL"
                        data-isactive="@item.IsActive"
                        data-bs-toggle="modal"
                        data-bs-target=".bs-example-modal-xl">Edit</a>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="DeleteId" value="@item.Id" />
                            <a class="btn btn-danger btn-rounded waves-effect waves-light btnDelete ">Delete</a>
                        </form>
                    </td>
                </tr>
            }
            }
        </tbody>
    </table>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function(){
        $('.btnEdit').click(function(){

        var Id = $(this).data('id');
        var LogoDarkURL = $(this).data('logodarkurl');
        var LogoLightURL = $(this).data('logolighturl');
        var SliderBackgroundURL = $(this).data('sliderbackgroundurl');
        var PopularBackgroundURL = $(this).data('popularbackgroundurl');
        var ReservationImageURL = $(this).data('reservationimageurl');
        var FooterText = $(this).data('footertext');
        var Location = $(this).data('location');
        var IsActive = $(this).data('isactive');

        $("#Id").val(Id);
        $("#FooterText").val(FooterText);
        $("#Location").val(Location);
        $("#IsActive").prop('checked', IsActive === true || IsActive === 'True' || IsActive === 'true');

        $("#LogoDarkURL").val(LogoDarkURL);
        $("#LogoLightURL").val(LogoLightURL);
        $("#SliderBackgroundURL").val(SliderBackgroundURL);
        $("#PopularBackgroundURL").val(PopularBackgroundURL);
        $("#ReservationImageURL").val(ReservationImageURL);

        $("#LogoDarkFile").val('');
        $("#LogoLightFile").val('');
        $("#SliderBackgroundFile").val('');
        $("#PopularBackgroundFile").val('');
        $("#ReservationImageFile").val('');

        if (LogoDarkURL) {
        $("#DarkLogoImagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="/SystemSettingsImages/${LogoDarkURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#DarkLogoImagePreview").empty();
        }
        if (LogoLightURL) {
        $("#LogoLightImagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="/SystemSettingsImages/${LogoLightURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#LogoLightImagePreview").empty();
        }
        if (SliderBackgroundURL) {
        $("#SliderBackgroundImagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="/SystemSettingsImages/${SliderBackgroundURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#SliderBackgroundImagePreview").empty();
        }
        if (PopularBackgroundURL) {
        $("#PopularBackgroundImagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="/SystemSettingsImages/${PopularBackgroundURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#PopularBackgroundImagePreview").empty();
        }
        if (ReservationImageURL) {
        $("#ReservationImagePreview").html(`
        <small class="text-muted d-block">Current Image:</small>
        <img src="/SystemSettingsImages/${ReservationImageURL}" style="max-height: 70px;" class="rounded border mt-1" />
        `);
        } else {
        $("#ReservationImagePreview").empty();
        }
        });

        $('#btnClear').click(function() {
        $("#DarkLogoImagePreview").empty();
        $("#LogoLightImagePreview").empty();
        $("#SliderBackgroundImagePreview").empty();
        $("#PopularBackgroundImagePreview").empty();
        $("#ReservationImagePreview").empty();
        $("#LogoDarkURL").val('');
        $("#LogoLightURL").val('');
        $("#SliderBackgroundURL").val('');
        $("#PopularBackgroundURL").val('');
        $("#ReservationImageURL").val('');
        });

        $('.bs-example-modal-xl').on('hidden.bs.modal', function() {
        $('#terminalForm')[0].reset();
        $('#Id').val('');
        $("#DarkLogoImagePreview").empty();
        $("#LogoLightImagePreview").empty();
        $("#SliderBackgroundImagePreview").empty();
        $("#PopularBackgroundImagePreview").empty();
        $("#ReservationImagePreview").empty();
        $("#LogoDarkURL").val('');
        $("#LogoLightURL").val('');
        $("#SliderBackgroundURL").val('');
        $("#PopularBackgroundURL").val('');
        $("#ReservationImageURL").val('');
        });

        $('.btnDelete').click(function(){
        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {
        if (result.isConfirmed) Swal.fire({
        title: "Deleted!",
        text: "Your file has been deleted.",
        icon: "success"
        });
        $(this).parent().submit();



        });
        })
        })
    </script>
}
