@model IEnumerable<RestaurantWebApp22092026.Models.TransactionContactUs>

<h1>User Messages</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Name</th>
            <th>Email</th>
            <th>Subject</th>
            <th>Message</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SendingDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Subject</td>
                <td>@item.Message</td>
                <td>
                    @if (item.IsReplied)
                    {
                        <span class="badge bg-success">Replied</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </td>
                <td>
                    @if (!item.IsReplied)
                    {
                        <button type="button" class="btn btn-sm btn-primary btnReply"
                                data-id="@item.Id"
                                data-email="@item.Email"
                                data-subject="@item.Subject"
                                data-bs-toggle="modal"
                                data-bs-target="#replyModal">
                            Reply
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-secondary">None</span>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Reply Modal -->
<div class="modal fade" id="replyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reply" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Reply to Message</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="replyId" />
                    
                    <div class="mb-3">
                        <label class="form-label">To:</label>
                        <input type="email" name="recipientEmail" id="replyEmail" class="form-control" readonly />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Subject:</label>
                        <input type="text" name="subject" id="replySubject" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Your Reply:</label>
                        <textarea name="replyMessage" class="form-control" rows="5" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Send Email</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on("click", ".btnReply", function () {
            $("#replyId").val($(this).data("id"));
            $("#replyEmail").val($(this).data("email"));
            $("#replySubject").val($(this).data("subject"));
        });
    </script>
}
